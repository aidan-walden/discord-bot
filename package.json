{
	"name": "discord-bot",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "biome check AGENTS.md README.md TODO.md biome.json config.yml drizzle.config.ts package.json tsconfig.json src",
		"db:generate": "drizzle-kit generate",
		"typecheck": "tsc --noEmit",
