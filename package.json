	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.133.0",
		"@discordjs/voice": "^0.19.2",
		"@spotify/web-api-ts-sdk": "^1.2.0",
		"canvaskit-wasm": "^0.42.0",
		"discord.js": "^14.27.0",
		"drizzle-orm": "^0.45.4",
		"ffmpeg-static": "^5.3.0",
		"hono": "^4.13.13",
		"kazagumo": "^3.4.3",
		"luxon": "^3.7.2",
		"node-apple-music": "^1.2.2",
		"openai": "^7.36.0",
